{
  "name": "fount-android",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "icons": "mkdir -p assets && swift ../scripts/make-icon.swift assets/icon.png --android && swift ../scripts/make-icon.swift assets/icon-monochrome.png --monochrome",
    "typecheck": "tsc --noEmit",
    "build:android": "npm run icons && EAS_NO_VCS=1 EAS_PROJECT_ROOT=\"$PWD\" npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.3.0"
  }
}
